# Copy this file to .env and fill in the values.
# All configuration lives here - nothing is hardcoded in code or appsettings.json.

# ---------- Database (PostgreSQL) ----------
DB_HOST=servio-db
DB_PORT=5432
DB_HOST_PORT=5440
DB_NAME=220208
DB_USER=servio
DB_PASSWORD=change-me

# ---------- RabbitMQ ----------
RABBITMQ_HOST=servio-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=servio
RABBITMQ_PASSWORD=change-me
RABBITMQ_EMAIL_QUEUE=servio.emails

# ---------- API ----------
API_PORT=5050
JWT_KEY=change-me-to-a-random-string-of-at-least-64-characters
JWT_ISSUER=servio-api
JWT_AUDIENCE=servio-clients
JWT_EXPIRES_MINUTES=720
RESTAURANT_TIME_ZONE=Europe/Sarajevo
CORS_ALLOWED_ORIGINS=http://localhost:5050

# ---------- PayPal (sandbox) ----------
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_RETURN_URL=servio://paypal/return
PAYPAL_CANCEL_URL=servio://paypal/cancel

# ---------- SMTP (used by Servio.Worker) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_FROM_EMAIL=no-reply@servio.app
SMTP_FROM_NAME=Servio
